<setup>
  // Page-level setup — static content, no reactivity needed
</setup>

<template>
  <div class="page">
    <h1>Interactive Islands</h1>
    <p>
      Only the <em>interactive</em> parts of a page hydrate in the browser.
      Static sections are pure HTML with zero JS.
    </p>

    <section class="static-section">
      <h2>📄 Static Content</h2>
      <p>This section ships as pure HTML — no JavaScript attached.</p>
    </section>

    <!-- Island component: hydrated with signals -->
    <Counter />
  </div>
</template>

