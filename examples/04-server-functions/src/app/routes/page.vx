<config>
definePage({
  title: "Server Functions — VELYX Example"
})
</config>

<setup>
  state message  = "";
  state loading  = false;
  state submitted = false;

  async function handleSubmit() {
    loading = true;
    // In real usage, call the server function imported from this file's
    // <script server> block. Here we simulate a fetch.
    await new Promise(r => setTimeout(r, 800));
    message   = "✅ Data saved successfully!";
    loading   = false;
    submitted = true;
  }
</setup>

<template>
  <div class="page">
    <h1>Server Functions</h1>
    <p>
      Server code lives in <code>&lt;script server&gt;</code> and never ships
      to the browser.
    </p>

    <form vx-submit="handleSubmit" class="form">
      <input type="text" placeholder="Enter something…" class="input" />
      <button type="submit" class="btn" vx-if="!loading">Submit</button>
      <button class="btn btn--loading" vx-if="loading" disabled>Sending…</button>
    </form>

    <p class="feedback" vx-if="submitted">{{ message }}</p>
  </div>
</template>

<script server>
  export async function saveData(payload: { text: string }) {
    // This runs on the server only — access DB, auth, etc.
    console.log('[server] saveData called with', payload);
    return { ok: true, id: crypto.randomUUID() };
  }
</script>

<style>
  .page { max-width: 560px; margin: 4rem auto; padding: 2rem; font-family: system-ui, sans-serif; color: #f1f5f9; }
  h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; color: #818cf8; }
  p { color: #94a3b8; margin-bottom: 1.5rem; }
  code { background: #1e293b; padding: 0.15em 0.4em; border-radius: 4px; }

  .form { display: flex; gap: 0.75rem; }
  .input { flex: 1; padding: 0.6rem 1rem; border-radius: 8px; border: 1px solid #1e293b; background: #111827; color: #f1f5f9; }
  .btn { background: #6366f1; color: #fff; border: none; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 700; cursor: pointer; }
  .btn--loading { background: #4338ca; cursor: not-allowed; }
  .feedback { color: #4ade80; font-weight: 600; margin-top: 1rem; }
</style>
