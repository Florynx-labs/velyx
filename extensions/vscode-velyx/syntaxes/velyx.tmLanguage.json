{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VELYX",
  "scopeName": "source.velyx",
  "patterns": [
    { "include": "#sfc-blocks" },
    { "include": "#mustache-expressions" }
  ],
  "repository": {
    "sfc-blocks": {
      "patterns": [
        {
          "begin": "(<)(template)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.template.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(</)(template)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.template.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "contentName": "text.html.velyx",
          "patterns": [
            { "include": "#mustache-expressions" },
            { "include": "#velyx-directives" },
            { "include": "#html-heading-tags" },
            { "include": "#html-block-tags" },
            { "include": "#html-inline-tags" },
            { "include": "#html-form-tags" },
            { "include": "#html-list-tags" },
            { "include": "#html-media-tags" },
            { "include": "#html-table-tags" },
            { "include": "#html-meta-tags" },
            { "include": "#html-closing-tags" },
            { "include": "#html-attributes" }
          ]
        },
        {
          "begin": "(<)(script)(\\s+server)?(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.script.velyx" },
            "3": { "name": "entity.other.attribute-name.server.velyx" },
            "4": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(</)(script)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.script.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "contentName": "meta.server.velyx",
          "patterns": [
            { "include": "#velyx-keywords" },
            { "include": "source.ts" }
          ]
        },
        {
          "begin": "(<)(setup)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.setup.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(</)(setup)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.setup.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "contentName": "meta.setup.velyx",
          "patterns": [
            { "include": "#velyx-keywords" },
            { "include": "source.ts" }
          ]
        },
        {
          "begin": "(<)(config)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.config.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(</)(config)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.config.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "contentName": "meta.config.velyx",
          "patterns": [
            {
              "name": "support.function.config.velyx",
              "match": "\\b(definePage|defineProps|defineComponent)\\b"
            },
            {
              "name": "string.quoted.double.velyx",
              "begin": "\"",
              "end": "\"",
              "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.velyx" }]
            },
            {
              "name": "string.quoted.single.velyx",
              "begin": "'",
              "end": "'",
              "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.velyx" }]
            },
            {
              "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*(?=:)",
              "name": "variable.object.property.velyx"
            },
            { "include": "#velyx-keywords" },
            { "include": "source.ts" }
          ]
        },
        {
          "begin": "(<)(style)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.style.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(</)(style)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.style.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "contentName": "source.css.velyx",
          "patterns": [
            { "include": "source.css" }
          ]
        },
        {
          "begin": "(<)(transition)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.transition.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(</)(transition)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.sfc.transition.velyx" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "contentName": "meta.transition.velyx",
          "patterns": [
            { "include": "#transition-rules" }
          ]
        }
      ]
    },

    "html-heading-tags": {
      "patterns": [
        {
          "begin": "(<)(h[1-6])(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.heading.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-block-tags": {
      "patterns": [
        {
          "begin": "(<)(div|section|article|main|header|footer|nav|aside|figure|figcaption|details|summary|dialog|template|slot)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.block.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-inline-tags": {
      "patterns": [
        {
          "begin": "(<)(p|span|a|strong|em|b|i|u|s|del|ins|mark|small|big|sub|sup|abbr|cite|code|kbd|samp|var|q|blockquote|pre|address|bdi|bdo|wbr|time|data|output)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.inline.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-form-tags": {
      "patterns": [
        {
          "begin": "(<)(form|input|button|select|textarea|label|fieldset|legend|datalist|optgroup|option|output|progress|meter)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.form.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-list-tags": {
      "patterns": [
        {
          "begin": "(<)(ul|ol|li|dl|dt|dd|menu)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.list.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-media-tags": {
      "patterns": [
        {
          "begin": "(<)(img|video|audio|canvas|svg|picture|source|track|iframe|embed|object|portal)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.media.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-table-tags": {
      "patterns": [
        {
          "begin": "(<)(table|thead|tbody|tfoot|tr|th|td|caption|col|colgroup)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.table.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#velyx-directives" },
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-meta-tags": {
      "patterns": [
        {
          "begin": "(<)(head|body|html|title|meta|link|script|style|base|noscript|br|hr|wbr)(?=[\\s>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.structure.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#html-attributes" }
          ]
        }
      ]
    },

    "html-closing-tags": {
      "patterns": [
        {
          "match": "(</)(h[1-6])(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.heading.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(div|section|article|main|header|footer|nav|aside|figure|figcaption|details|summary|dialog|slot)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.block.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(p|span|a|strong|em|b|i|u|s|del|ins|mark|small|sub|sup|abbr|cite|code|kbd|samp|var|q|blockquote|pre|address|time|data|output)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.inline.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(form|button|select|textarea|label|fieldset|legend|optgroup|option|progress|meter)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.form.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(ul|ol|li|dl|dt|dd|menu)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.list.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(video|audio|canvas|picture|iframe|embed|object)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.media.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(table|thead|tbody|tfoot|tr|th|td|caption|colgroup)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.table.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        }
      ]
    },

    "html-attributes": {
      "patterns": [
        {
          "match": "\\b(class|id|style|href|src|alt|type|name|value|placeholder|action|method|for|role|aria-[a-z-]+|data-[a-zA-Z0-9-]+|target|rel|title|width|height|disabled|readonly|required|checked|selected|multiple|autocomplete|autofocus|hidden|tabindex|lang|dir|draggable|contenteditable|spellcheck|translate)\\b",
          "name": "entity.other.attribute-name.html"
        },
        {
          "match": "\"([^\"]*)\"",
          "captures": {
            "0": { "name": "string.quoted.double.html" }
          }
        },
        {
          "match": "'([^']*)'",
          "captures": {
            "0": { "name": "string.quoted.single.html" }
          }
        }
      ]
    },

    "velyx-keywords": {
      "patterns": [
        {
          "name": "storage.type.state.velyx",
          "match": "\\b(state)\\b"
        },
        {
          "name": "storage.type.prop.velyx",
          "match": "\\b(prop)\\b"
        },
        {
          "name": "storage.type.computed.velyx",
          "match": "\\b(computed)\\b"
        },
        {
          "name": "storage.type.watch.velyx",
          "match": "\\b(watch)\\b"
        },
        {
          "name": "keyword.control.lifecycle.velyx",
          "match": "\\b(onMount|onDestroy)\\b"
        },
        {
          "name": "support.function.velyx",
          "match": "\\b(definePage|defineProps|defineComponent|provide|inject|batch|effect|component)\\b"
        },
        {
          "name": "support.type.velyx",
          "match": "\\b(string|number|boolean|object|unknown|never|void|Promise|Array)\\b"
        }
      ]
    },

    "velyx-directives": {
      "patterns": [
        {
          "match": "\\b(vx-(?:click|input|change|submit|model|if|for|show|transition|visible|idle|hover|media|interaction))((?:\\.(?:once|stop|prevent|capture|passive))*)(?=\\s|=|>)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.directive.velyx" },
            "2": { "name": "entity.other.attribute-name.modifier.velyx" }
          }
        }
      ]
    },

    "mustache-expressions": {
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template.expression.begin.velyx" }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.template.expression.end.velyx" }
      },
      "contentName": "meta.mustache.velyx",
      "patterns": [
        { "include": "source.ts" },
        { "include": "#velyx-keywords" },
        {
          "name": "keyword.operator.velyx",
          "match": "[-+/*%<>=&|!^~?:]+"
        },
        {
          "name": "constant.numeric.velyx",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "string.quoted.double.velyx",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.velyx" }]
        },
        {
          "name": "string.quoted.single.velyx",
          "begin": "'",
          "end": "'",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.velyx" }]
        },
        {
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*(?=\\()",
          "name": "entity.name.function.velyx"
        },
        {
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\b",
          "name": "variable.other.velyx"
        }
      ]
    },

    "transition-rules": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z0-9_-]+)\\s*\\{",
          "captures": {
            "1": { "name": "support.type.transition.velyx" }
          }
        },
        {
          "match": "\\b([0-9]+%)\\b",
          "name": "constant.numeric.percentage.velyx"
        },
        {
          "include": "source.css"
        }
      ]
    }
  }
}
