{
  "VELYX SFC (minimal)": {
    "prefix": "vel",
    "body": [
      "<setup>",
      "  $1",
      "</setup>",
      "",
      "<template>",
      "  <div class=\"$2\">",
      "    $3",
      "  </div>",
      "</template>",
      "",
      "<style>",
      "  .$2 {",
      "    $4",
      "  }",
      "</style>"
    ],
    "description": "VELYX minimal SFC with setup, template, and style"
  },
  "VELYX Page": {
    "prefix": "velpage",
    "body": [
      "<config>",
      "definePage({",
      "  title: \"${1:Page Title}\",",
      "  layout: \"${2:default}\"",
      "})",
      "</config>",
      "",
      "<setup>",
      "  $3",
      "</setup>",
      "",
      "<template>",
      "  <div class=\"${4:page}\">",
      "    <h1>${1:Page Title}</h1>",
      "    $5",
      "  </div>",
      "</template>",
      "",
      "<style>",
      "  .${4:page} {",
      "    padding: 2rem;",
      "  }",
      "</style>"
    ],
    "description": "VELYX page with config, setup, template, and style blocks"
  },
  "VELYX Component": {
    "prefix": "velcomponent",
    "body": [
      "<setup>",
      "  defineProps({",
      "    ${1:label}: \"${2:default}\"",
      "  })",
      "",
      "  $3",
      "</setup>",
      "",
      "<template>",
      "  <div class=\"${4:component}\">",
      "    $5",
      "  </div>",
      "</template>",
      "",
      "<style>",
      "  .${4:component} {",
      "    $6",
      "  }",
      "</style>"
    ],
    "description": "VELYX component with defineProps, template, and style"
  },
  "VELYX Server Handler": {
    "prefix": "velserver",
    "body": [
      "<script server>",
      "  export async function ${1:handler}(${2:data}: ${3:any}) {",
      "    $4",
      "    return { success: true };",
      "  }",
      "</script>"
    ],
    "description": "VELYX server-side function block"
  },
  "VELYX SFC Component": {
    "prefix": "vx-component",
    "body": [
      "<config>",
      "definePage({",
      "  title: \"${1:Title}\"",
      "})",
      "</config>",
      "",
      "<setup>",
      "  state ${2:count} = ${3:0};",
      "</setup>",
      "",
      "<template>",
      "  <div class=\"${4:app}\">",
      "    <h1>{{ ${2:count} }}</h1>",
      "  </div>",
      "</template>",
      "",
      "<style>",
      "  .${4:app} {",
      "    padding: 1rem;",
      "  }",
      "</style>"
    ],
    "description": "Create a full VELYX Single-File Component"
  },
  "VELYX Signal State": {
    "prefix": "vx-state",
    "body": [
      "state ${1:count} = ${2:0};"
    ],
    "description": "Declare a reactive signal state"
  },
  "VELYX Prop": {
    "prefix": "vx-prop",
    "body": [
      "prop ${1:name}: ${2:string} = ${3:\"default\"};"
    ],
    "description": "Declare a component property"
  },
  "VELYX Computed": {
    "prefix": "vx-computed",
    "body": [
      "computed ${1:double} = () => ${2:count} * 2;"
    ],
    "description": "Declare a derived computed state"
  },
  "VELYX Watch": {
    "prefix": "vx-watch",
    "body": [
      "watch(${1:stateName}, (${2:val}) => {",
      "  $3",
      "});"
    ],
    "description": "Watch a state for changes"
  },
  "VELYX Transition Block": {
    "prefix": "vx-transition",
    "body": [
      "<transition>",
      "  ${1:fade} {",
      "    0% { opacity: 0; transform: translateY(4px); }",
      "    100% { opacity: 1; transform: translateY(0); }",
      "  }",
      "</transition>"
    ],
    "description": "Add a VELYX WAAPI transition block"
  },
  "VELYX Server Script": {
    "prefix": "vx-server",
    "body": [
      "<script server>",
      "  export async function ${1:actionName}(${2:data}: ${3:any}) {",
      "    $4",
      "  }",
      "</script>"
    ],
    "description": "Add a VELYX server actions script block"
  },
  "VELYX Setup Block": {
    "prefix": "vx-setup",
    "body": [
      "<setup>",
      "  $1",
      "</setup>"
    ],
    "description": "Add a VELYX setup block"
  },
  "VELYX Config Block": {
    "prefix": "vx-config",
    "body": [
      "<config>",
      "definePage({",
      "  title: \"${1:Page Title}\",",
      "  layout: \"${2:default}\"",
      "})",
      "</config>"
    ],
    "description": "Add a VELYX page config block"
  }
}
